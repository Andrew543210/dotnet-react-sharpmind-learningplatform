# The setup script creates .env with random local passwords. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_PORT=54329
ConnectionStrings__Database=Host=localhost;Port=54329;Database=sharpmind;Username=sharpmind;Password=replace-with-a-random-local-password
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
# Optional demo accounts; only used by --seed-demo outside Production.
Demo__Password=replace-with-a-long-local-demo-passphrase
Content__MentorEmail=mentor@demo.sharpmind.test
# Production bootstrap only; remove these after creating the first administrator.
# Bootstrap__Email=owner@example.com
# Bootstrap__FullName=Course administrator
# Bootstrap__Password=replace-with-a-unique-long-passphrase
# DataProtection__KeyPath=/var/lib/sharpmind/keys
# Media__RootPath=/var/lib/sharpmind/media
# ReverseProxy__Address=10.0.0.2
